# Site Configuration
NEXT_PUBLIC_SITE_URL=https://lanework.ai

# Sanity CMS (shared with Rapid Relay: same project/dataset holds the research content)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-12-30
SANITY_API_WRITE_TOKEN=

# Database: Lanework's OWN Supabase project (separate from Rapid Relay). Prisma is
# the only client, so the connection string is all that's needed; there are no
# NEXT_PUBLIC_SUPABASE_* vars because nothing calls Supabase from the browser.
# Run `npx prisma db push` against it once to create the tables.
DATABASE_URL=

# Resend Email. The sending domain (lanework.ai) must be verified in Resend, or
# every send silently falls back to Resend's sandbox sender.
RESEND_API_KEY=
# Visible sender on outbound mail. NOTE: the variable is EMAIL_FROM, not FROM_EMAIL.
EMAIL_FROM=research@lanework.ai
# Where replies to marketing and transactional mail land.
SALES_REPLY_TO=hello@lanework.ai
# Internal notifications (contact form, new subscriber) are delivered here.
ADMIN_EMAIL=notifications@lanework.ai
# Named human sender for the final, personal drip note. Set both together: the name
# appears in the From line and the sign-off, the address is the actual sender.
PERSONAL_SENDER_EMAIL=alexander@lanework.ai
PERSONAL_SENDER_NAME=Alexander

# Newsletter API Key for Sanity Studio
SANITY_STUDIO_NEWSLETTER_API_KEY=

# Shared secret for the Sanity revalidation webhook (/api/revalidate). Any long
# random string; it must match the Secret field on the webhook in
# sanity.io/manage > API > Webhooks. Unset, that route returns 503 and publishing
# falls back to the 24h ISR window instead of going live in seconds.
SANITY_REVALIDATE_SECRET=

# Google Verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Analytics pixels (Phase 2). Each is optional and the corresponding pixel
# loader stays dormant when its ID is unset.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=                 # e.g. G-ABC123XYZ
GA4_API_SECRET=                                  # server-side MP secret (GA4 admin > Data Streams)
NEXT_PUBLIC_META_PIXEL_ID=                       # Facebook/Meta numeric pixel ID
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=                 # LinkedIn Insight Tag partner ID
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=         # LinkedIn conversion ID for lead form fills
NEXT_PUBLIC_LINKEDIN_DOWNLOAD_CONVERSION_ID=     # LinkedIn conversion ID for gated downloads

# Drip nurture cron (Phase 2). CRON_SECRET protects /api/cron/drip. Set a strong
# random value in production env vars. ALLOW_DRIP_TIME_SHIM is local-test-only.
CRON_SECRET=
ALLOW_DRIP_TIME_SHIM=

# Optional override for the URL used in Lanework transactional emails; defaults
# to https://lanework.ai when unset.
LANEWORK_SITE_URL=

# Basic-Auth gate over /admin/* (middleware.ts), which hosts the embedded Sanity
# Studio at /admin/studio. Studio has its own Sanity login on top of this.
# Unset in local dev lets you through; unset in production returns 503, so the
# area is never accidentally public.
ADMIN_USER=
ADMIN_PASSWORD=

# PostHog product analytics. Init no-ops cleanly when the key is unset.
# Lanework has its own PostHog project, separate from the Rapid Relay one.
# KEY: PostHog project "Project API Key" (starts with phc_).
# HOST: the region host — keep the US Cloud default below, or switch to eu. to match
#       the account's region. Used by lib/posthog-query.ts to derive the Query API
#       host, and by the client for ui_host (Toolbar links) and for local dev.
#       It must stay an ABSOLUTE PostHog URL: the server-side dashboard fetches with
#       it, and a relative value would throw "Failed to parse URL" in Node.
#       In production the browser does NOT post here — it goes through the
#       first-party proxy path configured in netlify.toml.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side read access for the native dashboard at /admin/analytics.
# Both are server-only — never prefix these with NEXT_PUBLIC_, a Personal API Key
# is high-privilege and must not reach the browser bundle.
# PERSONAL_API_KEY: PostHog → Settings → Personal API keys, with read/query scope.
# PROJECT_ID:       numeric project id, PostHog → Settings → Project.
# Until both are set the dashboard shows a setup panel instead of charts.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Server-only salt used to hash client IPs for contact-form anti-spam rate
# limiting (any long random string; raw IPs are never stored). Set in Netlify env.
RATE_LIMIT_SALT=